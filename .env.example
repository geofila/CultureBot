# ─────────────────────────────────────────────────────────────────────────────
# SearchCultureBot — environment configuration
#
# 1. Copy this file to `.env`   →   cp .env.example .env
# 2. Fill in the values below.
# 3. NEVER commit your real `.env` — it is listed in .gitignore.
#
# Generate strong random secrets with, e.g.:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (LLM generation + embeddings) ─────────────────────────────────────
# Required. Used by the RAG/KG pipeline for both chat completion and embeddings.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Generation model (default gpt-5.5). Options: gpt-5.5 | gpt-4o | gpt-4o-mini
OPENAI_MODEL=gpt-5.5
# Override only for Azure OpenAI or a local OpenAI-compatible proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Open WebUI ───────────────────────────────────────────────────────────────
# Required. Secret used to sign session cookies. Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=change-me-openssl-rand-hex-32
# Auth / signup behaviour (safe defaults for a public deployment).
WEBUI_AUTH=true
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
WEBUI_SESSION_COOKIE_SECURE=false
WEBUI_SESSION_COOKIE_SAME_SITE=lax
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=20
ENABLE_COMMUNITY_SHARING=false
SAFE_MODE=false

# ── Pipelines server ─────────────────────────────────────────────────────────
# Required. Token Open WebUI uses to authenticate to the pipelines server.
# In Open WebUI: Admin Panel → Settings → Connections → add an OpenAI API
# connection pointing at http://pipelines:9099 with this value as the API key.
# Generate with: openssl rand -hex 32
PIPELINES_API_KEY=change-me-openssl-rand-hex-32

# ── Neo4j Knowledge Graph ────────────────────────────────────────────────────
# Only required for the "kg" and "hybrid" query modes. Leave the password blank
# and set QUERY_MODE=rag in valves if you don't run a Neo4j graph.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Optional: local Ollama backend ───────────────────────────────────────────
# Only used if you uncomment the `ollama` service in compose.yml.
OLLAMA_BASE_URL=http://ollama:11434
